using System;
using System.IO;
using System.Linq;
using System.Security;
using System.Security.AccessControl;
using System.Security.Principal;
using System.Text;
using MagicTray;
class SkipTests {
static int passed; static string run,ftpRoot; static int port;
static void Assert(bool ok,string name){if(!ok)throw new Exception("FAIL: "+name);Console.WriteLine("PASS: "+name);passed++;}
static Config ConfigFor(string name){string src=Path.Combine(run,name,"source");Directory.CreateDirectory(src);Config c=new Config();c.Host="127.0.0.1";c.Port=port;c.User="tester";c.Password="空 格 & $ \" \\ end";c.Source=src;c.Destination=name;c.RemotePath="";c.RclonePath=(Environment.GetEnvironmentVariable("MAGICTRAY_TEST_RCLONE") ?? "rclone.exe");return c;}
static string Remote(Config c,string name){return Path.Combine(ftpRoot,c.Destination,name);}
static string App(string name){return Path.Combine(run,name,"app");}
static Stream Read(string p){return new FileStream(p,FileMode.Open,FileAccess.Read,FileShare.Read);}
sealed class DenyRead:IDisposable {
string path; bool dir; FileSystemSecurity before;
public DenyRead(string p,bool directory){path=p;dir=directory;before=dir?(FileSystemSecurity)Directory.GetAccessControl(p):File.GetAccessControl(p);FileSystemSecurity updated=dir?(FileSystemSecurity)Directory.GetAccessControl(p):File.GetAccessControl(p);updated.AddAccessRule(new FileSystemAccessRule(WindowsIdentity.GetCurrent().User,FileSystemRights.ReadData,AccessControlType.Deny));if(dir)Directory.SetAccessControl(p,(DirectorySecurity)updated);else File.SetAccessControl(p,(FileSecurity)updated);}
public void Dispose(){FileSystemSecurity restored=dir?(FileSystemSecurity)new DirectorySecurity():new FileSecurity();restored.SetSecurityDescriptorBinaryForm(before.GetSecurityDescriptorBinaryForm(),AccessControlSections.Access);if(dir)Directory.SetAccessControl(path,(DirectorySecurity)restored);else File.SetAccessControl(path,(FileSecurity)restored);}
}
static bool Retains(Config c,string name,string contents){string current=Remote(c,name);if(File.Exists(current)&&File.ReadAllText(current)==contents)return true;string versions=Path.Combine(ftpRoot,c.Destination+"_versions");return Directory.Exists(versions)&&Directory.GetFiles(versions,name,SearchOption.AllDirectories).Any(delegate(string p){return File.ReadAllText(p)==contents;});}
static void ScanSkips(){
Config c=ConfigFor("scan");string deniedDir=Path.Combine(c.Source,"无权访问目录"),linkDir=Path.Combine(c.Source,"link-dir"),deniedFile=Path.Combine(c.Source,"受限文件.txt"),linkFile=Path.Combine(c.Source,"link-file.txt");Directory.CreateDirectory(deniedDir);Directory.CreateDirectory(linkDir);File.WriteAllText(Path.Combine(deniedDir,"child.txt"),"child");File.WriteAllText(Path.Combine(linkDir,"link-child.txt"),"link child");File.WriteAllText(deniedFile,"restored");File.WriteAllText(linkFile,"link");File.WriteAllText(Path.Combine(c.Source,"readable.txt"),"readable");Directory.CreateDirectory(Path.Combine(ftpRoot,c.Destination));File.WriteAllText(Remote(c,"受限文件.txt"),"previous phone copy");
using(Engine e=new Engine(App("scan"))){
e.ListLocalEntries=delegate(string p){if(p.TrimEnd('\\')==deniedDir)throw new UnauthorizedAccessException();return Directory.GetFileSystemEntries(p);};
e.OpenLocalRead=delegate(string p){if(p==deniedFile)throw new SecurityException();return Read(p);};
e.LocalAttributes=delegate(string p){FileAttributes a=File.GetAttributes(p);return p.TrimEnd('\\')==linkDir||p==linkFile?a|FileAttributes.ReparsePoint:a;};
e.Backup(c);Assert(e.SkippedCount==4,"denied file/directory and both link types individually counted");Assert(File.ReadAllText(Remote(c,"readable.txt"))=="readable","readable siblings uploaded despite local denied entries");Assert(File.ReadAllText(Remote(c,"受限文件.txt"))=="previous phone copy","skipped path preserves previous phone copy");string report=e.ReadSkippedReport();Assert(report.Contains(deniedDir)&&report.Contains(deniedFile)&&report.Contains("其内部未扫描")&&report.Contains("目录链接")&&report.Contains("文件链接"),"skip list includes exact paths and distinct concise reasons");Assert(e.LastBackup.Contains("4 项跳过")&&!e.LastBackup.Contains("备份成功"),"partial backup summary explicitly says not backed up");string manifest=Directory.GetFiles(e.LogDir,"backup-manifest-*.json")[0];Assert(!File.ReadAllText(manifest).Contains("受限文件"),"skipped paths excluded from successful scan manifest");
using(Engine restarted=new Engine(App("scan"))){Assert(restarted.SkippedCount==4&&restarted.ReadSkippedReport()==report,"latest skip count and details survive restart");}
e.ListLocalEntries=Directory.GetFileSystemEntries;e.OpenLocalRead=Read;e.LocalAttributes=File.GetAttributes;e.Backup(c);Assert(e.SkippedCount==0&&File.ReadAllText(Remote(c,"受限文件.txt"))=="restored"&&File.Exists(Remote(c,"无权访问目录\\child.txt")),"restored permissions cause previously skipped entries to retry");Assert(e.ReadSkippedReport().Contains("本轮没有跳过项目"),"new successful run clears stale skip details");
e.ListLocalEntries=delegate(string p){throw new UnauthorizedAccessException();};e.Backup(c);Assert(e.SkippedCount==1&&e.LastBackup.Contains("未备份任何文件"),"inaccessible selected root counted once with no complete-success claim");Assert(e.ReadSkippedReport().Contains(c.Source)&&e.ReadSkippedReport().Contains("其内部未扫描"),"root denial report explains its interior was not scanned");
}
Config all=ConfigFor("all");File.WriteAllText(Path.Combine(all.Source,"one.txt"),"one");File.WriteAllText(Path.Combine(all.Source,"two.txt"),"two");using(Engine e=new Engine(App("all"))){e.OpenLocalRead=delegate{throw new UnauthorizedAccessException();};e.Backup(all);Assert(e.SkippedCount==2&&e.LastBackup.Contains("未备份任何文件"),"all individual files skipped gives explicit no-files-backed-up result");}
Config missing=ConfigFor("missing");missing.Source=Path.Combine(missing.Source,"does-not-exist");bool invalid=false;try{missing.Validate(true);}catch(Exception ex){invalid=ex.Message.Contains("存在的电脑源文件夹");}Assert(invalid,"nonexistent source remains an input error");
}
static void RealRootAcl(){Config c=ConfigFor("root-acl");File.WriteAllText(Path.Combine(c.Source,"inside.txt"),"inside");using(Engine e=new Engine(App("root-acl"))){using(DenyRead acl=new DenyRead(c.Source,true)){e.Backup(c);Assert(e.SkippedCount==1&&e.LastBackup.Contains("未备份任何文件"),"real generated root ACL denial reaches scanner and is reported");}e.Backup(c);Assert(File.Exists(Remote(c,"inside.txt"))&&e.SkippedCount==0,"real root ACL restoration retries interior files");}}
static void LateAcl(string name,bool single){Config c=ConfigFor(name);string blocked=Path.Combine(c.Source,"blocked.txt");File.WriteAllText(blocked,"updated blocked");Directory.CreateDirectory(Path.Combine(ftpRoot,c.Destination));File.WriteAllText(Remote(c,"blocked.txt"),"original blocked");if(!single){File.WriteAllText(Path.Combine(c.Source,"allowed.txt"),"updated allowed");File.WriteAllText(Remote(c,"allowed.txt"),"original allowed");}DenyRead deny=null;using(Engine e=new Engine(App(name))){e.Message+=delegate(string message){Console.WriteLine(message);if(message.Contains("本轮检查")&&deny==null)deny=new DenyRead(blocked,false);};try{e.Backup(c);Assert(e.SkippedCount==1,"upload-time source ACL denial accurately classified");Assert(Retains(c,"blocked.txt","original blocked"),"late-denied source retains original complete phone version");if(!single){Assert(File.ReadAllText(Remote(c,"allowed.txt"))=="updated allowed","other readable upload continues after late permission change");Assert(Retains(c,"allowed.txt","original allowed"),"retry does not overwrite readable file original old version");}else Assert(e.LastBackup.Contains("未备份任何文件"),"sole late-denied source ends as no files backed up, not generic failure");Assert(!File.ReadAllText(Directory.GetFiles(e.LogDir,"backup-manifest-*.json")[0]).Contains("blocked.txt"),"late-denied source excluded from manifest");}finally{if(deny!=null)deny.Dispose();}e.Backup(c);Assert(File.ReadAllText(Remote(c,"blocked.txt"))=="updated blocked"&&e.SkippedCount==0,"late permission restoration retries skipped source next run");}}
static void FailureAndCancel(){Config c=ConfigFor("io-failure");File.WriteAllText(Path.Combine(c.Source,"readable.txt"),"content");using(Engine e=new Engine(App("io-failure"))){e.ListLocalEntries=delegate{throw new IOException("Synthetic disk failure");};bool failed=false;try{e.Backup(c);}catch(IOException){failed=true;}Assert(failed&&e.SkippedCount==0&&e.LastBackup.Contains("备份失败"),"non-permission local IO error stays failure");Assert(Directory.GetFiles(e.LogDir,"backup-manifest-*.json").Length==0,"failed scan never saves successful manifest");}
Config cancel=ConfigFor("cancel");File.WriteAllText(Path.Combine(cancel.Source,"denied.txt"),"denied");File.WriteAllBytes(Path.Combine(cancel.Source,"large.bin"),new byte[3*1024*1024]);using(Engine e=new Engine(App("cancel"))){e.OpenLocalRead=delegate(string p){if(Path.GetFileName(p)=="denied.txt")throw new UnauthorizedAccessException();return Read(p);};e.Stats+=delegate{e.Cancel();};bool stopped=false;try{e.Backup(cancel);}catch(OperationCanceledException){stopped=true;}Assert(stopped&&e.SkippedCount==1&&e.LastBackup.Contains("已停止"),"cancel after scan skips retains stopped status");Assert(e.ReadSkippedReport().Contains("已停止")&&e.ReadSkippedReport().Contains("未完成"),"cancelled report persists known skips and incomplete status");Assert(Directory.GetFiles(e.LogDir,"backup-manifest-*.json").Length==0,"cancelled run never writes successful manifest");}}
static void RemoteDenied(){Config c=ConfigFor("remote-denied");File.WriteAllText(Path.Combine(c.Source,"upload.txt"),"content");bool afterScan=false;int probes=0;using(Engine e=new Engine(App("remote-denied"))){e.Message+=delegate(string s){if(s.Contains("本轮检查"))afterScan=true;};e.OpenLocalRead=delegate(string p){if(afterScan){probes++;throw new UnauthorizedAccessException();}return Read(p);};bool failed=false;try{e.Backup(c);}catch(Exception ex){failed=ex.Message.Contains("Synthetic upload permission denied");}Assert(failed&&e.SkippedCount==0&&probes==0,"FTP destination denial is never classified as local skip");Assert(Directory.GetFiles(e.LogDir,"backup-manifest-*.json").Length==0,"FTP failure does not save successful manifest");}}
static void MixedRemote(){Config c=ConfigFor("mixed-remote");string blocked=Path.Combine(c.Source,"blocked.txt");File.WriteAllText(blocked,"blocked");File.WriteAllText(Path.Combine(c.Source,"remote-error.txt"),"remote");File.WriteAllText(Path.Combine(c.Source,"allowed.txt"),"allowed");DenyRead deny=null;using(Engine e=new Engine(App("mixed-remote"))){e.Message+=delegate(string s){if(s.Contains("本轮检查")&&deny==null)deny=new DenyRead(blocked,false);};try{bool failed=false;try{e.Backup(c);}catch(Exception ex){failed=ex.Message.Contains("Synthetic upload permission denied");}Assert(failed&&e.SkippedCount==1,"mixed source ACL and destination refusal remains failed");Assert(File.Exists(Remote(c,"allowed.txt")),"mixed failure still uploads readable permitted sibling");string[] manifests=Directory.GetFiles(e.LogDir,"backup-manifest-*.json");Assert(manifests.Length==1&&File.ReadAllText(manifests[0]).Contains("allowed")&&!File.ReadAllText(manifests[0]).Contains("blocked")&&!File.ReadAllText(manifests[0]).Contains("remote-error"),"mixed failure records only confirmed uploaded files");Assert(e.ReadSkippedReport().Contains("部分完成")&&e.ReadSkippedReport().Contains("blocked.txt"),"mixed failure report retains only confirmed source skip");}finally{if(deny!=null)deny.Dispose();}}}
static int Main(string[] args){run=Path.GetFullPath(args[0]);port=int.Parse(args[1]);ftpRoot=Path.GetFullPath(args[2]);Directory.CreateDirectory(run);Console.SetOut(new StreamWriter(Path.Combine(run,"test-results.log"),false,new UTF8Encoding(false)){AutoFlush=true});try{if(args[3]=="remote")RemoteDenied();else if(args[3]=="mixed")MixedRemote();else{ScanSkips();RealRootAcl();LateAcl("late-acl",false);LateAcl("sole-late-acl",true);FailureAndCancel();}Console.WriteLine("ALL PASSED: "+passed);return 0;}catch(Exception ex){Console.WriteLine(ex);return 1;}}
}


